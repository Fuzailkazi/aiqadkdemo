# --- Model (Google ADK needs one) ---
# Free key, no billing account: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- ArmorIQ ---
# From your ArmorIQ console.
ARMORIQ_API_KEY=

# Your own email. Every action this agent takes gets attributed to this
# address in the ArmorIQ console — use a real one so approvals/audit make
# sense when you're demoing it live.
USER_EMAIL=

# Optional. Defaults to gemini-2.5-flash-lite (bigger free-tier quota than
# the full flash models). Each model has its own free-tier limit.
GEMINI_MODEL=

# Optional. URL of the weather MCP service (see mcp/weather-mcp/DEPLOY.md).
# Leave empty to spawn the MCP locally over stdio instead.
# Local HTTP test: http://localhost:8080/mcp
WEATHER_MCP_URL=
